# --- Python general ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
*.pkl
*.sqlite3

# Byte-compiled / optimized / DLL files
*.so
*.dll
*.dylib

# Virtual environments
.venv/
venv/
env/

# Jupyter / IPython
.ipynb_checkpoints/
*.ipynb

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# Logs / temp
*.log
*.tmp
*.temp

# IDEs / Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS cruft
.DS_Store
Thumbs.db

# --- Project-specific: keep PHI/financial data out of git ---

# DO NOT commit raw EMR / Gravity files
input/*.xlsx
input/*.csv

# But allow you to track any template docs you might add later
!input/README.md

# Output files (always regenerated by main.py)
output/*
!output/.gitkeep
