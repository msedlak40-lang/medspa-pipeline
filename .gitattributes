# Normalize line endings for text files
* text=auto

# Force LF for source code
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf

# Windows scripts (keep CRLF to avoid execution issues)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.xlsx binary
*.xlsm binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.pkl binary
